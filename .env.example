# Copy to .env and fill in. Find these at https://octopus.energy/dashboard/new/accounts/personal-details/api-access
OCTOPUS_API_KEY=your-octopus-api-key
# With ACCOUNT_NUMBER set, MPANs, serials and tariff rates are looked up automatically
ACCOUNT_NUMBER=A-XXXXXXXX
# Optional overrides (leave blank to use what the account reports)
IMPORT_MPAN=
EXPORT_MPAN=
METER_SERIAL=
# Optional: only needed if your export register has a different serial number
# EXPORT_METER_SERIAL=

# Optional: Sigen battery history (your mySigen app login). Adds battery charge level to the analysis.
# SIGEN_USERNAME=you@example.com
# SIGEN_PASSWORD=
# SIGEN_REGION=eu
